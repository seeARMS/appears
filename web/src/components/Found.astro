---
// The hero's emblem: the Orbit mark, with a few things it has found drifting
// out around it. Decorative only.
import Mark from "./Mark.astro";

// Each item drifts out from the mark to (x, y), in px from the centre.
const items = [
  { kind: "doc", x: -86, y: -18, r: -8 },
  { kind: "photo", x: -54, y: 30, r: 5 },
  { kind: "pdf", x: 60, y: -26, r: 7 },
  { kind: "quote", x: 92, y: 20, r: -4 },
];
---

<div class="found" aria-hidden="true">
  <span class="found-ring"></span>
  {
    items.map((item, i) => (
      <span
        class:list={["found-item", `is-${item.kind}`]}
        style={`--x: ${item.x}px; --y: ${item.y}px; --r: ${item.r}deg; --i: ${i}`}
      >
        {item.kind === "doc" && (
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
            <path d="M3 3.5h8M3 6.5h8M3 9.5h5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
          </svg>
        )}
        {item.kind === "photo" && (
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
            <circle cx="4.5" cy="4.5" r="1.4" fill="currentColor" />
            <path d="M1.5 11.5 5.5 7l2.5 2.5L10 7.5l2.5 4z" fill="currentColor" />
          </svg>
        )}
        {item.kind === "pdf" && <span class="found-tag">PDF</span>}
        {item.kind === "quote" && (
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
            <path
              d="M2.5 9.5c0-3 1-4.6 3-5.3M7.5 9.5c0-3 1-4.6 3-5.3"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
            />
          </svg>
        )}
      </span>
    ))
  }
  <span class="found-mark"><Mark size={44} /></span>
</div>
