---
// The still illustrations on the Privacy cards, in HTML and CSS (styles under
// "Privacy art" in global.css). Quieter than the "How it works" scenes: one
// small object each, drawn in the zinc scale, with blue only where it means
// "found".
import Glyph from "./Glyph.astro";

interface Props {
  art: "local" | "forget" | "private" | "open";
}
const { art } = Astro.props;
---

<div class:list={["scene", "pa", `pa-${art}`]} aria-hidden="true">
  {
    art === "local" && (
      <>
        <svg class="pa-cloud" width="40" height="28" viewBox="0 0 40 28" fill="none">
          <path
            d="M11 23h19a7 7 0 0 0 .6-14A10 10 0 0 0 11.4 11 6 6 0 0 0 11 23Z"
            stroke="currentColor"
            stroke-width="1.3"
            stroke-dasharray="2.5 2.5"
          />
          <path d="M6 26 34 2" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
        </svg>
        <div class="pa-laptop">
          <span class="pa-screen">
            <Glyph state="found" size={22} />
          </span>
          <span class="pa-base" />
        </div>
      </>
    )
  }
  {
    art === "forget" && (
      <div class="pa-sheet">
        <span class="pa-lines">
          <i />
          <i />
          <i />
          <i />
        </span>
        <span class="pa-kept">
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
            <path d="m2 5.2 2 2L8 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          Useful
        </span>
      </div>
    )
  }
  {
    art === "private" && (
      <div class="pa-field">
        <span class="pa-label" />
        <span class="pa-input">
          <span class="pa-dots">
            <i />
            <i />
            <i />
            <i />
            <i />
            <i />
          </span>
        </span>
        <span class="pa-lock">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
            <rect x="2.5" y="5.25" width="7" height="5" rx="1.2" fill="currentColor" />
            <path d="M4 5.25V4a2 2 0 0 1 4 0v1.25" stroke="currentColor" stroke-width="1.3" />
          </svg>
        </span>
      </div>
    )
  }
  {
    art === "open" && (
      <div class="pa-code">
        <span class="pa-row" style="--w: 46%" />
        <span class="pa-row" style="--w: 62%; --in: 1" />
        <span class="pa-row is-accent" style="--w: 38%; --in: 2" />
        <span class="pa-row" style="--w: 54%; --in: 1" />
        <span class="pa-row" style="--w: 20%" />
        <span class="pa-mit">MIT</span>
      </div>
    )
  }
</div>
