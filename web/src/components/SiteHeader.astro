---
import Mark from "./Mark.astro";
import Icon from "./Icon.astro";
import { DOWNLOAD_URL } from "../site";
---

<header class="top">
  <div class="wrap top-inner">
    <a class="brand" href="/" aria-label="Appears, home">
      <Mark size={24} />
      <span class="wordmark">appears</span>
    </a>
    <nav class="top-nav" aria-label="Main navigation">
      <a class="button button-primary" href={DOWNLOAD_URL}><Icon name="download" size={15} />Download</a>
    </nav>
  </div>
</header>
