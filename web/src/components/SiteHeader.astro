---
import Mark from "./Mark.astro";
import { DOWNLOAD_URL, GUIDE_TEXT } from "../site";

const { home = false } = Astro.props;
const anchor = (id: string) => `${home ? "" : "/"}#${id}`;
---

<header class="top">
  <div class="wrap top-inner">
    <a class="brand" href="/" aria-label="Appears, home">
      <Mark size={24} />
      <span class="wordmark">appears</span>
    </a>
    <nav class="top-nav" aria-label="Main navigation">
      <a class="nav-how" href={anchor("how")}>How it works</a>
      <a href={anchor("guides")}>{GUIDE_TEXT.nav}</a>
      <a href={anchor("privacy")}>Privacy</a>
      <a class="top-get" href={DOWNLOAD_URL}>Download</a>
    </nav>
  </div>
</header>
