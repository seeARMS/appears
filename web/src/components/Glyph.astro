---
// Orbit's five monochrome template states, matching mac/App/Sources/Glyph.swift.
import { ORBIT } from "../lib/orbit";
interface Props {
  state: "idle" | "indexing" | "found" | "paused" | "setup";
  size?: number;
}
const { state, size = 16 } = Astro.props;
---

<svg class="glyph" width={size} height={size} viewBox="0 0 24 24" fill="none" aria-hidden="true">
  <path d={state === "indexing" ? ORBIT.indexingArc : ORBIT.arc} stroke="currentColor" stroke-width={ORBIT.lineWidth} stroke-linecap="round" />
  {state === "found" && <circle class="glyph-dot" cx={ORBIT.dot.x} cy={ORBIT.dot.y} r={ORBIT.dot.radius} fill="currentColor" />}
  {state === "paused" && <path d="M 9.5 10.3 V 15.3 M 13.5 10.3 V 15.3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />}
  {state === "setup" && <>
    <path d="M 11.5 9.1 V 12.3" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" />
    <circle cx="11.5" cy="15.5" r="1" fill="currentColor" />
  </>}
</svg>
