---
// Actual SwiftUI snapshots, rendered with the repository's fictional demo data.
import { getImage } from "astro:assets";
import lightSource from "../../../docs/screenshots/search-contacts-light.png";
import darkSource from "../../../docs/screenshots/search-contacts-dark.png";
import { SEARCH } from "../site";

const [light, dark] = await Promise.all(
  [lightSource, darkSource].map((src) => getImage({ src, format: "webp", widths: [688, 960, 1376] })),
);
const sizes = "(max-width: 720px) calc(100vw - 2rem), (max-width: 1164px) 58vw, 680px";
---

<figure class="app-screenshot">
  <picture>
    <source media="(prefers-color-scheme: dark)" type="image/webp" srcset={dark.srcSet.attribute} sizes={sizes} />
    <img
      src={light.src}
      srcset={light.srcSet.attribute}
      sizes={sizes}
      width={lightSource.width}
      height={lightSource.height}
      alt={SEARCH.alt}
      loading="lazy"
      decoding="async"
    />
  </picture>
  <figcaption>{SEARCH.caption}</figcaption>
</figure>
