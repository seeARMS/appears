---
import Mark from "./Mark.astro";
import Icon from "./Icon.astro";
import { AUTHOR, GUIDES_INDEX, GUIDE_TEXT, NAME, SOURCE_LABEL, SOURCE_URL } from "../site";
---

<footer class="foot">
  <div class="wrap foot-inner">
    <a class="brand" href="/" aria-label="Appears, home">
      <Mark size={20} />
      <span class="wordmark">appears</span>
    </a>
    <p>
      {NAME} is made by <a href={AUTHOR.url}>{AUTHOR.name}</a>.
    </p>
    <nav class="foot-links" aria-label="Footer navigation">
      <a href={GUIDES_INDEX.path}>{GUIDE_TEXT.nav}</a>
      <a class="foot-github" href={SOURCE_URL} aria-label={SOURCE_LABEL} title={SOURCE_LABEL}><Icon name="github" size={20} /></a>
    </nav>
  </div>
</footer>
