---
// Orbit, from the same artwork as brand/mark.svg and public/favicon.svg.
import { orbitMarkArtwork } from "../lib/orbit";
interface Props {
  size?: number;
  class?: string;
}
const { size = 24, class: className } = Astro.props;
---

<svg class:list={["mark", className]} width={size} height={size} viewBox="0 0 48 48" fill="none" aria-hidden="true">
  <Fragment set:html={orbitMarkArtwork()} />
</svg>
