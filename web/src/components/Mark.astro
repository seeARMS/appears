---
// Appears' mark (brand/mark.svg at the repo root): a field of view (the ring)
// with something surfacing at its top edge (the dot). The ring takes the text
// colour; the dot is always the signal colour.
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: className } = Astro.props;
---

<svg class:list={["mark", className]} width={size} height={size} viewBox="0 0 64 64" fill="none" aria-hidden="true">
  <circle cx="32" cy="34" r="22" stroke="currentColor" stroke-width="5"></circle>
  <circle class="mark-dot" cx="32" cy="17" r="8" fill="var(--signal)"></circle>
</svg>
