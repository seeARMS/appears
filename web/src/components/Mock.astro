---
// The hero's mock, in HTML and CSS rather than an image: a Mail reply to Dana
// Ruiz on a desktop, and Appears' panel hanging from its menu bar glyph with
// three things you already had, grouped like a ⌘K results list. Every name,
// file and number here is made up. The results and their groups come from
// MOCK_RESULTS in src/site.ts; the email is written here.
import Glyph from "./Glyph.astro";
import { MOCK_CAPTION, MOCK_NOTE, MOCK_RESULTS } from "../site";

const SUBJECT = "Re: Kitchen, can you start on the 14th?";
const groups = [...new Set(MOCK_RESULTS.map((r) => r.group))].map((name) => ({
  name,
  results: MOCK_RESULTS.filter((r) => r.group === name),
}));
const first = MOCK_RESULTS[0];
---

<figure class="mock">
  <div class="desk" aria-hidden="true">
    <div class="menubar">
      <span class="mb-app">Mail</span>
      <span class="mb-item">File</span>
      <span class="mb-item">Edit</span>
      <span class="mb-item">View</span>
      <span class="mb-item">Message</span>
      <span class="mb-item mb-extra">Format</span>
      <span class="mb-item mb-extra">Window</span>
      <span class="mb-spacer"></span>
      <span class="mb-glyph"><Glyph state="found" size={15} /></span>
      <span class="mb-clock">Thu 10:42</span>
    </div>

    <div class="stage">
      <div class="compose">
        <div class="titlebar">
          <span class="lights"><i></i><i></i><i></i></span>
          <span class="titlebar-name">{SUBJECT}</span>
        </div>
        <div class="field"><span class="field-label">To:</span> <span class="token">Dana Ruiz</span></div>
        <div class="field"><span class="field-label">Subject:</span> {SUBJECT}</div>
        <div class="body">
          <p>Hi Dana,</p>
          <p>
            The 14th works for us. Before we order the cabinets, can you confirm the numbers from your original quote? I
            also want to be sure the permit covers moving the sink to the island<span class="caret"></span>
          </p>
          <div class="quoted">
            <p class="quoted-head">On Oct 13, 2026, at 4:18 PM, Dana Ruiz wrote:</p>
            <p>I can start on the 14th if the permit is still good. Let me know about the cabinets.</p>
            <p>Dana<br />Ruiz &amp; Daughters Builders</p>
          </div>
        </div>
      </div>

      <div class="panel">
        <div class="panel-head">
          <div>
            <p class="panel-title">Related</p>
            <p class="panel-sub">Re: Kitchen · Mail</p>
          </div>
          <span class="badge">{MOCK_RESULTS.length} found</span>
        </div>
        {
          groups.map((g, gi) => (
            <>
              {gi > 0 && <div class="sep" />}
              <div class="group">
                <p class="group-label">{g.name}</p>
                <ul class="results">
                  {g.results.map((r) => (
                    <li class:list={["result", { "is-selected": r === first }]}>
                      <span class:list={["thumb", `thumb-${r.kind}`]}>
                        {r.kind === "photo" && (
                          <span class="paper">
                            <i />
                            <i />
                            <i />
                            <i />
                          </span>
                        )}
                        {r.kind === "pdf" && (
                          <span class="page">
                            <i />
                          </span>
                        )}
                        {r.kind === "note" && <span class="sticky" />}
                      </span>
                      <span class="result-text">
                        <span class="result-title">{r.title}</span>
                        <span class="result-reason">{r.reason}</span>
                      </span>
                      {r === first && <kbd class="result-kbd">↩</kbd>}
                    </li>
                  ))}
                </ul>
              </div>
            </>
          ))
        }
        <div class="panel-foot">
          <span><kbd>↩</kbd> open</span>
          <span><kbd>␣</kbd> preview</span>
          <span><kbd>⌫</kbd> not useful</span>
        </div>
      </div>
    </div>
  </div>
  <figcaption>{MOCK_CAPTION} <span class="mock-note">{MOCK_NOTE}</span></figcaption>
</figure>
