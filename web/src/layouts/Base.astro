---
import { Font } from "astro:assets";
import { CARD, DESCRIPTION, NAME } from "../site";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  path: string;
  /** This page's Markdown version, for agents. */
  markdown?: string;
  /** schema.org nodes for this page, rendered as one JSON-LD graph. */
  schema?: object[];
}

const { title, description = DESCRIPTION, path, markdown, schema } = Astro.props;
const canonical = new URL(path, Astro.site).href;
const image = new URL("/og.png", Astro.site).href;
const jsonLd = schema && JSON.stringify({ "@context": "https://schema.org", "@graph": schema });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Colin Armstrong" />
    <link rel="canonical" href={canonical} />
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} />}
    <link rel="describedby" href="/llms.txt" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#09090B" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={NAME} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={CARD.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@colinarms" />
    <meta name="twitter:creator" content="@colinarms" />
    <Font cssVariable="--font-sans" preload />
    {jsonLd && <script type="application/ld+json" is:inline set:html={jsonLd} />}
  </head>
  <body>
    <slot />
  </body>
</html>
