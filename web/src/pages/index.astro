---
// The one page. Its copy is in src/site.ts, which the Markdown version
// (index.md.ts) and llms.txt read too.
import Base from "../layouts/Base.astro";
import Glyph from "../components/Glyph.astro";
import Mark from "../components/Mark.astro";
import Mock from "../components/Mock.astro";
import { inline } from "../lib/inline";
import {
  AUTHOR,
  DESCRIPTION,
  GLYPHS,
  HEADLINE,
  HOW,
  HOW_HEADING,
  LEDE,
  LICENSE,
  LICENSE_URL,
  NAME,
  NOW,
  NOW_HEADING,
  OPERATING_SYSTEM,
  PRIVACY,
  PRIVACY_HEADING,
  QUIET,
  QUIET_HEADING,
  SITE,
  STATUS,
  STATUS_TEXT,
  SUMMARY,
  TITLE,
} from "../site";

const schema = [
  {
    "@type": "WebSite",
    "@id": `${SITE}/#website`,
    url: `${SITE}/`,
    name: NAME,
    description: DESCRIPTION,
    inLanguage: "en",
    about: { "@id": `${SITE}/#app` },
    publisher: { "@id": AUTHOR.id },
  },
  {
    "@type": "SoftwareApplication",
    "@id": `${SITE}/#app`,
    name: NAME,
    url: `${SITE}/`,
    description: DESCRIPTION,
    disambiguatingDescription: SUMMARY,
    operatingSystem: OPERATING_SYSTEM,
    applicationCategory: "UtilitiesApplication",
    isAccessibleForFree: true,
    license: LICENSE_URL,
    image: `${SITE}/og.png`,
    author: { "@id": AUTHOR.id },
    creator: { "@id": AUTHOR.id },
  },
  {
    "@type": "Person",
    "@id": AUTHOR.id,
    name: AUTHOR.name,
    url: AUTHOR.url,
    disambiguatingDescription: AUTHOR.disambiguation,
    sameAs: AUTHOR.sameAs,
  },
];
---

<Base title={TITLE} path="/" markdown="/index.md" schema={schema}>
  <header class="top">
    <div class="wrap top-inner">
      <a class="brand" href="/" aria-label="Appears, home">
        <Mark size={24} />
        <span class="wordmark">appears</span>
      </a>
      <nav class="top-nav" aria-label="On this page">
        <a href="#how">How it works</a>
        <a href="#privacy">Privacy</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero wrap">
      <span class="badge badge-status"><span class="badge-dot" aria-hidden="true"></span>{STATUS}</span>
      <h1>{HEADLINE}</h1>
      <p class="lede">{LEDE}</p>
      <div class="actions">
        <a class="button button-primary" href="#how">How it works</a>
        <a class="button button-outline" href="#privacy">Privacy</a>
      </div>
      <p class="note">{STATUS_TEXT}</p>
    </section>

    <div class="wrap">
      <Mock />
    </div>

    <section class="part wrap" aria-labelledby="how">
      <div class="part-head">
        <p class="eyebrow">How it works</p>
        <h2 id="how">{HOW_HEADING}</h2>
      </div>
      <ol class="cards">
        {
          HOW.map((item, i) => (
            <li class="card">
              <span class="card-num" aria-hidden="true">{i + 1}</span>
              <h3>{item.title}</h3>
              <p set:html={inline(item.text)} />
            </li>
          ))
        }
      </ol>
    </section>

    <section class="part wrap" aria-labelledby="quiet">
      <div class="split">
        <div class="part-head">
          <p class="eyebrow">Attention</p>
          <h2 id="quiet">{QUIET_HEADING}</h2>
          <p class="part-text">{QUIET}</p>
        </div>
        <figure class="card glyphs">
          <ul>
            {
              GLYPHS.map((g) => (
                <li>
                  <span class:list={["glyph-chip", `is-${g.state}`]}>
                    <Glyph state={g.state} size={20} />
                  </span>
                  <span class="glyph-label">{g.label}</span>
                  <span class="glyph-state">{g.state}</span>
                </li>
              ))
            }
          </ul>
          <figcaption>The menu bar glyph, in each of its states.</figcaption>
        </figure>
      </div>
    </section>

    <section class="part wrap" aria-labelledby="privacy">
      <div class="part-head">
        <p class="eyebrow">Privacy</p>
        <h2 id="privacy">{PRIVACY_HEADING}</h2>
      </div>
      <dl class="cards">
        {
          PRIVACY.map((row) => (
            <div class="card">
              <dt>{row.label}</dt>
              <dd set:html={inline(row.text)} />
            </div>
          ))
        }
      </dl>
    </section>

    <section class="part wrap" aria-labelledby="now">
      <div class="card now">
        <div>
          <p class="eyebrow">Status</p>
          <h2 id="now">{NOW_HEADING}</h2>
          <p class="part-text">{NOW}</p>
        </div>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="wrap foot-inner">
      <a class="brand" href="/" aria-label="Appears, home">
        <Mark size={20} />
        <span class="wordmark">appears</span>
      </a>
      <p>
        {NAME} is made by <a href={AUTHOR.url}>{AUTHOR.name}</a>. <a href={LICENSE_URL}>{LICENSE} license</a>.
      </p>
    </div>
  </footer>
</Base>
