---
// The home page. Its copy is in src/site.ts, which the Markdown version
// (index.md.ts) and llms.txt read too.
import Base from "../layouts/Base.astro";
import AppScreenshot from "../components/AppScreenshot.astro";
import Found from "../components/Found.astro";
import Glyph from "../components/Glyph.astro";
import Icon from "../components/Icon.astro";
import Mark from "../components/Mark.astro";
import Mock from "../components/Mock.astro";
import PrivacyArt from "../components/PrivacyArt.astro";
import Scene from "../components/Scene.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { inline } from "../lib/inline";
import {
  AUTHOR,
  DESCRIPTION,
  DOWNLOAD_LABEL,
  DOWNLOAD_URL,
  FAQ,
  FAQ_HEADING,
  GET_HEADING,
  GET_TEXT,
  GUIDES,
  GUIDES_HEADING,
  GUIDES_INTRO,
  GUIDE_TEXT,
  guidePath,
  GLYPHS,
  HEADLINE,
  HOW,
  HOW_HEADING,
  LEDE,
  LICENSE_URL,
  NAME,
  NOTE,
  OPERATING_SYSTEM,
  PRIVACY,
  PRIVACY_HEADING,
  PRIVACY_TEXT,
  QUIET,
  QUIET_HEADING,
  SITE,
  SEARCH,
  SUMMARY,
  TITLE,
} from "../site";

const schema = [
  {
    "@type": "WebSite",
    "@id": `${SITE}/#website`,
    url: `${SITE}/`,
    name: NAME,
    description: DESCRIPTION,
    inLanguage: "en",
    about: { "@id": `${SITE}/#app` },
    publisher: { "@id": AUTHOR.id },
  },
  {
    "@type": "SoftwareApplication",
    "@id": `${SITE}/#app`,
    name: NAME,
    url: `${SITE}/`,
    description: DESCRIPTION,
    disambiguatingDescription: SUMMARY,
    operatingSystem: OPERATING_SYSTEM,
    applicationCategory: "UtilitiesApplication",
    isAccessibleForFree: true,
    downloadUrl: new URL(DOWNLOAD_URL, SITE).href,
    license: LICENSE_URL,
    image: `${SITE}/og.png`,
    author: { "@id": AUTHOR.id },
    creator: { "@id": AUTHOR.id },
  },
  {
    "@type": "Person",
    "@id": AUTHOR.id,
    name: AUTHOR.name,
    url: AUTHOR.url,
    disambiguatingDescription: AUTHOR.disambiguation,
    sameAs: AUTHOR.sameAs,
  },
];
---

<Base title={TITLE} path="/" markdown="/index.md" schema={schema}>
  <SiteHeader home />

  <main>
    <section class="hero wrap">
      <div class="rise" style="--d: 0">
        <Found />
      </div>
      <h1 class="rise" style="--d: 1">{HEADLINE}</h1>
      <p class="lede rise" style="--d: 2">{LEDE}</p>
      <div class="actions rise" style="--d: 3">
        <a class="button button-primary" href={DOWNLOAD_URL}><Icon name="download" size={16} />{DOWNLOAD_LABEL}</a>
        <a class="button button-outline" href="#how">See how it works<Icon name="arrow-down" size={15} /></a>
      </div>
      <p class="note rise" style="--d: 4" set:html={inline(NOTE)} />
    </section>

    <div class="wrap rise" style="--d: 5">
      <Mock />
    </div>

    <section id="search" class="part wrap search-section" aria-labelledby="search-heading">
      <div class="search-intro reveal">
        <p class="eyebrow">{SEARCH.eyebrow}</p>
        <h2 id="search-heading">{SEARCH.heading}</h2>
        <p class="part-text">{SEARCH.text}</p>
      </div>
      <AppScreenshot />
    </section>

    <section class="part wrap" aria-labelledby="how">
      <div class="part-head reveal">
        <p class="eyebrow">How it works</p>
        <h2 id="how">{HOW_HEADING}</h2>
      </div>
      <ol class="cards">
        {
          HOW.map((item, i) => (
            <li class="card card-scene reveal" style={`--d: ${i}`}>
              <Scene scene={item.scene} />
              <h3>{item.title}</h3>
              <p set:html={inline(item.text)} />
            </li>
          ))
        }
      </ol>
    </section>

    <section class="part wrap" aria-labelledby="quiet">
      <div class="split">
        <div class="part-head reveal">
          <p class="eyebrow">Quiet by design</p>
          <h2 id="quiet">{QUIET_HEADING}</h2>
          <p class="part-text">{QUIET}</p>
        </div>
        <figure class="card glyphs reveal" style="--d: 1">
          <ul>
            {
              GLYPHS.map((g) => (
                <li>
                  <span class:list={["glyph-chip", `is-${g.state}`]}>
                    <Glyph state={g.state} size={20} />
                  </span>
                  <span class="glyph-label">{g.label}</span>
                </li>
              ))
            }
          </ul>
          <figcaption>The little ring in your menu bar, and what it's telling you.</figcaption>
        </figure>
      </div>
    </section>

    <section class="part wrap" aria-labelledby="privacy">
      <div class="part-head reveal">
        <p class="eyebrow">Privacy</p>
        <h2 id="privacy">{PRIVACY_HEADING}</h2>
        <p class="part-text">{PRIVACY_TEXT}</p>
      </div>
      <dl class="cards cards-4">
        {
          PRIVACY.map((row, i) => (
            <div class="card card-scene reveal" style={`--d: ${i}`}>
              <PrivacyArt art={row.art} />
              <dt>{row.label}</dt>
              <dd set:html={inline(row.text)} />
            </div>
          ))
        }
      </dl>
    </section>

    <section class="part wrap" aria-labelledby="guides">
      <div class="part-head reveal">
        <p class="eyebrow">{GUIDE_TEXT.label}</p>
        <h2 id="guides">{GUIDES_HEADING}</h2>
        <p class="part-text">{GUIDES_INTRO}</p>
      </div>
      <div class="guide-links">
        {GUIDES.map((guide) => (
          <a class="guide-link" href={guidePath(guide.slug)}>
            <div>
              <h3>{guide.title.split(" | ")[0]}</h3>
              <p>{guide.summary}</p>
            </div>
            <Icon name="arrow-down" size={18} />
          </a>
        ))}
      </div>
    </section>

    <section class="part wrap" aria-labelledby="questions">
      <div class="faq">
        <div class="part-head reveal">
          <p class="eyebrow">FAQ</p>
          <h2 id="questions">{FAQ_HEADING}</h2>
        </div>
        <div class="faq-list reveal" style="--d: 1">
          {
            FAQ.map((item) => (
              <details class="faq-item">
                <summary>
                  {item.q}
                  <Icon name="chevron-down" size={16} />
                </summary>
                <div class="faq-answer">
                  {item.a.map((para) => (
                    <p set:html={inline(para)} />
                  ))}
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="part wrap" aria-labelledby="get">
      <div class="card get reveal">
        <span class="get-mark"><Mark size={56} /></span>
        <h2 id="get">{GET_HEADING}</h2>
        <p class="part-text">{GET_TEXT}</p>
        <div class="actions">
          <a class="button button-primary" href={DOWNLOAD_URL}><Icon name="download" size={16} />{DOWNLOAD_LABEL}</a>
        </div>
        <p class="note" set:html={inline(NOTE)} />
      </div>
    </section>
  </main>

  <SiteFooter />

  <script>
    // Fades each section in as it scrolls into view. Without JavaScript, or
    // with reduced motion, everything is simply there.
    const items = document.querySelectorAll(".reveal");
    if ("IntersectionObserver" in window && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
      document.documentElement.classList.add("reveals");
      const seen = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            e.target.classList.add("in");
            seen.unobserve(e.target);
          }
        },
        { rootMargin: "0px 0px -8% 0px" },
      );
      items.forEach((el) => seen.observe(el));
    }
  </script>
</Base>
