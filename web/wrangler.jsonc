{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "appears",
	// Colin Personal. Pinned so a deploy can never land on another account.
	"account_id": "68d615b353a7fe2663d3e7154366864a",
	// src/worker.ts serves the page's Markdown to agents that ask for it.
	"main": "./src/worker.ts",
	"compatibility_date": "2026-10-13",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// Pages negotiate Markdown; downloads stream from R2. Site assets
		// The signed update feed is promoted in R2 with each verified release.
		"run_worker_first": ["/", "/index.md", "/guides/*", "/app.dmg", "/appcast.xml", "/downloads/*", "/models/*"]
	},
	"r2_buckets": [{ "binding": "DOWNLOADS", "bucket_name": "appears-downloads" }],
	"routes": [{ "pattern": "appea.rs", "custom_domain": true }],
	// Keep the workers.dev URL too; handy for checking a deploy before DNS catches up.
	"workers_dev": true,
	// Workers Builds uses `wrangler preview` for pull request branches.
	"previews": {},
	"observability": {
		"enabled": true
	}
}
